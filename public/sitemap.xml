<?xml version="1.0" encoding="UTF-8"?>
<!--
  Allen Code Co — sitemap.xml

  Lives at https://www.allencodeco.com/sitemap.xml and is referenced from
  /robots.txt.

  WHY THIS FILE LISTS ONE URL
    src/App.jsx mounts the app inside a <HashRouter>. Every route on this
    site is therefore a fragment — /#/products, /#/products/underfire-ai,
    /#/services and so on — and a fragment is not a separate URL as far as
    a crawler is concerned: everything after the '#' is dropped before the
    request is ever made, and Google retired the AJAX-crawling scheme that
    used to work around that. The apex is the only address a search engine
    can actually fetch, so it is the only honest entry here.

    An earlier version of this file listed static .html pages left over
    from the pre-React site — products.html, chris-allen-portfolio.html,
    my-teachers-toolbox-showcase.html, underfireai-showcase.html,
    founders-helm-showcase.html, kirra-companion-showcase.html,
    colabmotion-showcase.html, vision-home-ai-showcase.html, and /thanks.
    None of those exist in this build. Every one of them returned a 404 to
    crawlers, which is worse than not listing them at all. Removed.

  IF PER-PAGE INDEXING IS WANTED LATER
    Switch HashRouter to BrowserRouter in src/App.jsx, add an SPA rewrite
    so every path serves index.html, then list the real routes here:
    /products, /products/<slug> (four), /services, /templates, /about,
    /contact. Until that change ships, adding them back here only
    re-creates the 404s.

  NAMESPACE
    The previous file declared xmlns="http://www.sitemap.org/..." —
    singular, and not a real schema. The correct sitemaps.org namespace is
    below; the old value would fail validation in Search Console.

  LAST MODIFIED
    Update <lastmod> whenever the homepage is materially edited so
    re-crawling is prioritized.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  <!-- Homepage — the only crawlable URL while the app uses HashRouter -->
  <url>
    <loc>https://www.allencodeco.com/</loc>
    <lastmod>2026-08-23</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>

</urlset>
