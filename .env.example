# Copy this file to .env.local for local `vercel dev` testing, and set the
# same values in the Vercel project's Environment Variables settings for
# Preview/Production. Never commit real values.

# Stripe secret key (test mode: sk_test_..., live mode: sk_live_...)
# Used by /api/create-checkout-session.js
STRIPE_SECRET_KEY=

# Resend API key -- https://resend.com/api-keys
# Used by /api/send-contact-email.js
RESEND_API_KEY=

# Must be an email address on a domain you've verified in Resend
# (e.g. "Allen Code Co. <notifications@allencodeco.com>")
CONTACT_FROM_EMAIL=

# Where contact form submissions are delivered. Optional -- defaults to
# chris@allencodeco.com if unset.
CONTACT_TO_EMAIL=chris@allencodeco.com
