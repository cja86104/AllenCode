    "excerpts:verify": "node tools/excerpts/verify.mjs",
    "media:capture": "node tools/media/capture-products.mjs",
    "media:loops": "node tools/media/make-loops.mjs"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
