    "framer-motion": "^11.0.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "^0.553.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.26.0",
    "resend": "^6.18.0",
    "stripe": "^22.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@testing-library/dom": "^10.4.2",
